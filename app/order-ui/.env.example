# Địa chỉ API mà TRÌNH DUYỆT gọi.
VITE_BASE_API_URL="localhost:8000/api/v1"

# Tuỳ chọn — chỉ cần khi muốn thử trên điện thoại thật.
#
# Camera chỉ chạy trên secure context, nên phải mở trang qua HTTPS hoặc
# `localhost` chứ không dùng được địa chỉ LAN kiểu http://192.168.x.x. Mà khi mở
# qua tunnel HTTPS hay qua `adb reverse`, origin của trang khác với origin mà
# backend cho phép, nên mọi request bị CORS chặn.
#
# Cách gỡ: cho trình duyệt gọi đường dẫn TƯƠNG ĐỐI để cùng origin với trang, còn
# dev server chuyển tiếp tới backend thật. Khai hai biến như sau:
#
#   VITE_BASE_API_URL=/api/v1
#   VITE_API_PROXY_TARGET=https://sandbox.order.cmsiot.net/api/${VERSION}
#
# Không khai `VITE_API_PROXY_TARGET` thì proxy vẫn dùng `VITE_BASE_API_URL` như
# trước, nên bỏ qua phần này cũng không sao.
# VITE_API_PROXY_TARGET=

VITE_ORDER_EXPIRATION_TIME_SECONDS=900
